<?xml version="1.0"?>
<!-- Interface principale de la description du robot-chien. -->
<!-- Ce fichier assemble la description robot sans mélanger la description de l'usine. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="factory_dog">
  <!-- Charge la géométrie, les articulations, les capteurs et les plugins Gazebo. -->
  <xacro:include filename="$(find dog_robot_description)/urdf/dog_robot_core.xacro"/>
</robot>
