<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="factory_dog">
  <xacro:arg name="use_sim" default="true"/>
  <material name="dog_blue"><color rgba="0.04 0.18 0.32 1"/></material>
  <material name="dog_orange"><color rgba="0.95 0.28 0.04 1"/></material>
  <material name="rubber"><color rgba="0.03 0.03 0.03 1"/></material>
  <xacro:macro name="box_inertial" params="mass x y z"><inertial><mass value="${mass}"/><inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/></inertial></xacro:macro>
  <xacro:macro name="link_box" params="name mass x y z material"><link name="${name}"><visual><origin xyz="0 0 0"/><geometry><box size="${x} ${y} ${z}"/></geometry><material name="${material}"/></visual><collision><geometry><box size="${x} ${y} ${z}"/></geometry></collision><xacro:box_inertial mass="${mass}" x="${x}" y="${y}" z="${z}"/></link></xacro:macro>
  <link name="base_link"><visual><geometry><box size="0.72 0.38 0.24"/></geometry><material name="dog_blue"/></visual><collision><geometry><box size="0.72 0.38 0.24"/></geometry></collision><xacro:box_inertial mass="18" x="0.72" y="0.38" z="0.24"/></link>
  <link name="body_shell"><visual><origin xyz="0 0 0.13"/><geometry><box size="0.56 0.32 0.12"/></geometry><material name="dog_orange"/></visual><collision><origin xyz="0 0 0.13"/><geometry><box size="0.56 0.32 0.12"/></geometry></collision><xacro:box_inertial mass="2" x="0.56" y="0.32" z="0.12"/></link>
  <joint name="body_shell_fixed" type="fixed"><parent link="base_link"/><child link="body_shell"/><origin xyz="0 0 0"/></joint>
  <link name="head_link"><visual><geometry><box size="0.22 0.26 0.22"/></geometry><material name="dog_blue"/></visual><collision><geometry><box size="0.22 0.26 0.22"/></geometry></collision><xacro:box_inertial mass="2" x="0.22" y="0.26" z="0.22"/></link>
  <joint name="neck_joint" type="revolute"><parent link="base_link"/><child link="head_link"/><origin xyz="0.40 0 0.08"/><axis xyz="0 0 1"/><limit lower="-0.7" upper="0.7" effort="20" velocity="2"/></joint>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.06" length="0.05"/></geometry><material name="rubber"/></visual><collision><geometry><cylinder radius="0.06" length="0.05"/></geometry></collision><xacro:box_inertial mass="0.2" x="0.1" y="0.1" z="0.05"/></link>
  <joint name="lidar_fixed" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.28"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.06 0.08 0.05"/></geometry><material name="rubber"/></visual><collision><geometry><box size="0.06 0.08 0.05"/></geometry></collision><xacro:box_inertial mass="0.1" x="0.06" y="0.08" z="0.05"/></link>
  <joint name="camera_fixed" type="fixed"><parent link="head_link"/><child link="camera_link"/><origin xyz="0.14 0 0" rpy="0 0 0"/></joint>
  <xacro:macro name="leg" params="prefix x y sign"><link name="${prefix}_hip"><visual><geometry><cylinder radius="0.055" length="0.12"/></geometry><material name="dog_orange"/></visual><collision><geometry><cylinder radius="0.055" length="0.12"/></geometry></collision><xacro:box_inertial mass="0.6" x="0.12" y="0.12" z="0.12"/></link><joint name="${prefix}_hip_joint" type="revolute"><parent link="base_link"/><child link="${prefix}_hip"/><origin xyz="${x} ${y} 0" rpy="1.5708 0 0"/><axis xyz="0 0 1"/><limit lower="-1.1" upper="1.1" effort="60" velocity="5"/></joint><link name="${prefix}_thigh"><visual><origin xyz="0 0 -0.18"/><geometry><box size="0.10 0.10 0.36"/></geometry><material name="dog_blue"/></visual><collision><origin xyz="0 0 -0.18"/><geometry><box size="0.10 0.10 0.36"/></geometry></collision><xacro:box_inertial mass="1.2" x="0.1" y="0.1" z="0.36"/></link><joint name="${prefix}_knee_joint" type="revolute"><parent link="${prefix}_hip"/><child link="${prefix}_thigh"/><origin xyz="0 0 -0.04"/><axis xyz="0 1 0"/><limit lower="-2.2" upper="0.3" effort="80" velocity="6"/></joint><link name="${prefix}_shin"><visual><origin xyz="0 0 -0.16"/><geometry><box size="0.08 0.08 0.32"/></geometry><material name="dog_orange"/></visual><collision><origin xyz="0 0 -0.16"/><geometry><box size="0.08 0.08 0.32"/></geometry></collision><xacro:box_inertial mass="0.8" x="0.08" y="0.08" z="0.32"/></link><joint name="${prefix}_ankle_joint" type="revolute"><parent link="${prefix}_thigh"/><child link="${prefix}_shin"/><origin xyz="0 0 -0.36"/><axis xyz="0 1 0"/><limit lower="-1.4" upper="1.4" effort="60" velocity="6"/></joint><link name="${prefix}_foot"><visual><origin xyz="0.06 0 -0.04"/><geometry><box size="0.20 0.12 0.08"/></geometry><material name="rubber"/></visual><collision><origin xyz="0.06 0 -0.04"/><geometry><box size="0.20 0.12 0.08"/></geometry></collision><xacro:box_inertial mass="0.5" x="0.2" y="0.12" z="0.08"/></link><joint name="${prefix}_foot_joint" type="fixed"><parent link="${prefix}_shin"/><child link="${prefix}_foot"/><origin xyz="0 0 -0.32"/></joint></xacro:macro>
  <xacro:leg prefix="front_left" x="0.25" y="0.20" sign="1"/><xacro:leg prefix="front_right" x="0.25" y="-0.20" sign="-1"/><xacro:leg prefix="rear_left" x="-0.25" y="0.20" sign="1"/><xacro:leg prefix="rear_right" x="-0.25" y="-0.20" sign="-1"/>
  <gazebo reference="base_link"><material>Gazebo/Blue</material><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="lidar_link"><sensor name="factory_lidar" type="ray"><pose>0 0 0 0 0 0</pose><update_rate>15</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range></ray><plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>lidar_link</frame_name></plugin></sensor></gazebo>
  <gazebo reference="camera_link"><sensor name="factory_camera" type="camera"><update_rate>10</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>30</far></clip></camera><plugin name="camera_controller" filename="libgazebo_ros_camera.so"><ros><remapping>image_raw:=image_raw</remapping></ros><frame_name>camera_link</frame_name></plugin></sensor></gazebo>
  <gazebo><plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so"><ros><remapping>odom:=odom</remapping></ros><body_name>base_link</body_name><frame_name>odom</frame_name><update_rate>50</update_rate></plugin></gazebo>
</robot>
